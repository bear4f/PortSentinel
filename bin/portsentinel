#!/usr/bin/env bash
# shellcheck disable=SC2016 # Single-quoted jq programs intentionally use jq variables.
set -Eeuo pipefail
umask 077

readonly VERSION="1.3.1"
readonly CHAIN="PORTSENTINEL"
readonly STAGE_CHAIN="PORTSENTINEL_NEW"
readonly OLD_CHAIN="PORTSENTINEL_OLD"

CONFIG_DIR="${PORTSENTINEL_CONFIG_DIR:-/etc/portsentinel}"
CONFIG_FILE="${PORTSENTINEL_CONFIG_FILE:-${CONFIG_DIR}/config.json}"
BACKUP_DIR="${PORTSENTINEL_BACKUP_DIR:-${CONFIG_DIR}/backups}"
APPLIED_MARKER="${PORTSENTINEL_APPLIED_MARKER:-${CONFIG_DIR}/.applied}"
CONF_FILE="${PORTSENTINEL_CONF_FILE:-${CONFIG_DIR}/portsentinel.conf}"
LOG_FILE="${PORTSENTINEL_LOG_FILE:-/var/log/portsentinel.log}"
LOCK_FILE="${PORTSENTINEL_LOCK_FILE:-/run/portsentinel.lock}"
IPTABLES="${PORTSENTINEL_IPTABLES:-iptables}"
IP6TABLES="${PORTSENTINEL_IP6TABLES:-ip6tables}"
IPTABLES_SAVE="${PORTSENTINEL_IPTABLES_SAVE:-iptables-save}"
IP6TABLES_SAVE="${PORTSENTINEL_IP6TABLES_SAVE:-ip6tables-save}"
IPTABLES_RESTORE="${PORTSENTINEL_IPTABLES_RESTORE:-iptables-restore}"
IP6TABLES_RESTORE="${PORTSENTINEL_IP6TABLES_RESTORE:-ip6tables-restore}"
IP_CMD="${PORTSENTINEL_IP:-ip}"
SS_CMD="${PORTSENTINEL_SS:-ss}"
FLOCK_CMD="${PORTSENTINEL_FLOCK:-flock}"
UPDATE_INSTALLER_URL="${PORTSENTINEL_UPDATE_URL:-https://raw.githubusercontent.com/bear4f/PortSentinel/main/install.sh}"
BACKUP_KEEP="${PORTSENTINEL_BACKUP_KEEP:-20}"
if [[ -r "$CONF_FILE" ]]; then
    configured_keep="$(awk -F= '$1 == "BACKUP_KEEP" {print $2; exit}' "$CONF_FILE")"
    [[ "$configured_keep" =~ ^[0-9]+$ ]] && BACKUP_KEEP="$configured_keep"
fi
[[ "$BACKUP_KEEP" =~ ^[0-9]+$ ]] || BACKUP_KEEP=20
# 轮转必须保留本次事务备份，否则回滚会失去依据。
(( BACKUP_KEEP >= 2 )) || BACKUP_KEEP=2

NON_INTERACTIVE=0
DRY_RUN=0
PRESERVE_CURRENT_SSH=0
TRANSACTION_ACTIVE=0
TRANSACTION_BACKUP=""
SKIP_IPV6=0
PRESERVE_SSH_SOURCE=""
PRESERVE_SSH_FAMILY=0
PRESERVE_SSH_PORT=0
declare -a RULES_V4=()
declare -a RULES_V6=()

UI_COLS=80
UI_RULE=64
UI_LABEL=17
UI_WIDE=1
UI_UTF8=1
readonly PROMPT_CANCEL=2

color() {
    if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then printf '\033[%sm' "$1"; fi
}

# 面板依赖多字节字符宽度计算，因此优先切换到可用的 UTF-8 字符集。
ui_use_utf8_ctype() {
    local candidate
    command -v locale >/dev/null 2>&1 || return 1
    candidate="$(locale -a 2>/dev/null | grep -iE '^(C|en_US)\.utf-?8$' | head -n 1)"
    [[ -n "$candidate" ]] || candidate="$(locale -a 2>/dev/null | grep -iE '\.utf-?8$' | head -n 1)"
    [[ -n "$candidate" ]] || return 1
    # LC_ALL 会覆盖 LC_CTYPE，因此仅在它已被设置时一并对齐。
    [[ -z "${LC_ALL:-}" ]] || export LC_ALL="$candidate"
    export LC_CTYPE="$candidate"
    return 0
}

ui_detect_terminal() {
    local locale_name="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" columns=""
    case "${locale_name,,}" in
        *utf-8*|*utf8*) UI_UTF8=1 ;;
        *) if ui_use_utf8_ctype; then UI_UTF8=1; else UI_UTF8=0; fi ;;
    esac
    columns="${COLUMNS:-}"
    if [[ ! "$columns" =~ ^[0-9]+$ ]] && command -v tput >/dev/null 2>&1; then
        columns="$(tput cols 2>/dev/null || true)"
    fi
    if [[ ! "$columns" =~ ^[0-9]+$ ]] || (( columns < 20 )); then
        columns=80
    fi
    UI_COLS="$columns"
    if (( UI_COLS >= 58 )); then UI_WIDE=1; else UI_WIDE=0; fi
    UI_RULE=$(( UI_COLS - 4 ))
    if (( UI_RULE > 64 )); then UI_RULE=64; fi
    if (( UI_RULE < 20 )); then UI_RULE=20; fi
}

# 计算终端显示宽度：CJK 字符占两列，其余占一列。
ui_width() {
    local text="$1" width=0 index char code
    if (( ! UI_UTF8 )); then
        # 无 UTF-8 字符集时按字节估算：三字节的中日韩字符占两列。
        local narrow="${text//[^ -~]/}"
        printf '%s' "$(( ${#narrow} + ((${#text} - ${#narrow}) * 2 + 2) / 3 ))"
        return 0
    fi
    for (( index=0; index<${#text}; index++ )); do
        char="${text:index:1}"
        printf -v code '%d' "'${char}" 2>/dev/null || code=63
        if (( code >= 0x1100 )) && {
                (( code <= 0x115F )) ||
                (( code >= 0x2E80 && code <= 0x303E )) ||
                (( code >= 0x3041 && code <= 0x33FF )) ||
                (( code >= 0x3400 && code <= 0x4DBF )) ||
                (( code >= 0x4E00 && code <= 0x9FFF )) ||
                (( code >= 0xA000 && code <= 0xA4CF )) ||
                (( code >= 0xAC00 && code <= 0xD7A3 )) ||
                (( code >= 0xF900 && code <= 0xFAFF )) ||
                (( code >= 0xFE30 && code <= 0xFE6F )) ||
                (( code >= 0xFF00 && code <= 0xFF60 )) ||
                (( code >= 0xFFE0 && code <= 0xFFE6 )); }; then
            width=$(( width + 2 ))
        else
            width=$(( width + 1 ))
        fi
    done
    printf '%s' "$width"
}

ui_repeat() {
    local token="$1" count="$2" output="" index
    for (( index=0; index<count; index++ )); do output+="$token"; done
    printf '%s' "$output"
}

ui_pad() {
    local text="$1" target="$2" width
    width="$(ui_width "$text")"
    printf '%s' "$text"
    if (( width < target )); then printf '%*s' "$(( target - width ))" ''; fi
}

ui_clear() {
    if [[ -t 1 ]]; then printf '\033[H\033[2J'; fi
}

ui_header() {
    printf '\n  %sPortSentinel%s %sv%s%s\n' "$(color '1;36')" "$(color 0)" "$(color 2)" "$VERSION" "$(color 0)"
    printf '  %sLinux 双栈端口白名单管理工具%s\n' "$(color 2)" "$(color 0)"
}

ui_section() {
    local label="$1" width fill
    width="$(ui_width "$label")"
    fill=$(( UI_RULE - width - 1 ))
    printf '\n  %s%s%s ' "$(color '1;36')" "$label" "$(color 0)"
    if (( fill > 0 )); then printf '%s%s%s' "$(color 2)" "$(ui_repeat '─' "$fill")" "$(color 0)"; fi
    printf '\n'
}

ui_item() {
    local key="$1" label="$2" detail="${3:-}"
    printf '  %s[%s]%s ' "$(color '1;36')" "$key" "$(color 0)"
    if [[ -n "$detail" ]] && (( UI_WIDE )); then
        ui_pad "$label" "$UI_LABEL"
        printf ' %s%s%s' "$(color 2)" "$detail" "$(color 0)"
    else
        printf '%s' "$label"
    fi
    printf '\n'
}

ui_field() {
    local label="$1" value="$2" tone="${3:-0}"
    printf '  %s' "$(color 2)"
    ui_pad "$label" 14
    printf '%s%s%s%s\n' "$(color 0)" "$(color "$tone")" "$value" "$(color 0)"
}

ui_divider() {
    printf '\n  %s%s%s\n' "$(color 2)" "$(ui_repeat '─' "$UI_RULE")" "$(color 0)"
}

ui_note() { printf '  %s%s%s\n' "$(color 2)" "$*" "$(color 0)"; }

ui_prompt() { printf '\n%s  请选择操作 › %s' "$(color '1;36')" "$(color 0)"; }

ui_pause() {
    printf '\n  %s按 Enter 返回菜单%s ' "$(color 2)" "$(color 0)"
    read -r _ || printf '\n'
}

info() { printf '  %s✓%s %s\n' "$(color '1;32')" "$(color 0)" "$*"; }
warn() { printf '  %s!%s %s\n' "$(color '1;33')" "$(color 0)" "$*" >&2; }
die() { printf '  %s✗%s %s\n' "$(color '1;31')" "$(color 0)" "$*" >&2; exit 1; }

# 统一输入：读取一行，输入 q 表示放弃当前操作并返回菜单。
prompt_input() {
    # 变量名前缀 _psi_ 避免与调用方传入的变量名冲突。
    local _psi_target="$1" _psi_label="$2" _psi_value=""
    if ! read -r -p "$(printf '  %s%s%s ' "$(color '1;36')" "$_psi_label" "$(color 0)")" _psi_value; then
        printf '\n' >&2
        return "$PROMPT_CANCEL"
    fi
    case "$_psi_value" in
        q|Q) return "$PROMPT_CANCEL" ;;
    esac
    printf -v "$_psi_target" '%s' "$_psi_value"
}

# 编号选项：仅接受列出的序号，输入无效时留在当前步骤。
prompt_select() {
    local _pss_target="$1" _pss_label="$2"
    shift 2
    local _pss_option="" _pss_value="" _pss_index=1
    while true; do
        _pss_index=1
        for _pss_option in "$@"; do
            printf '    %s[%s]%s %s\n' "$(color '1;36')" "$_pss_index" "$(color 0)" "${_pss_option#*:}"
            _pss_index=$(( _pss_index + 1 ))
        done
        prompt_input _pss_value "$_pss_label" || return "$PROMPT_CANCEL"
        if [[ "$_pss_value" =~ ^[0-9]+$ ]] && (( _pss_value >= 1 && _pss_value <= $# )); then
            _pss_option="${!_pss_value}"
            printf -v "$_pss_target" '%s' "${_pss_option%%:*}"
            return 0
        fi
        warn "无效选项，请重新选择。"
    done
}

confirm() {
    local _psc_answer=""
    prompt_input _psc_answer "$1 [y/N]" || return 1
    [[ "$_psc_answer" == [Yy] || "$_psc_answer" == [Yy][Ee][Ss] ]]
}

ui_hint() { ui_note '输入 q 可随时放弃当前操作并返回菜单。'; }

log_event() {
    local operation="$1" result="$2" detail="${3:-}"
    local line
    line="$(date -u '+%Y-%m-%dT%H:%M:%SZ') operation=${operation} result=${result} ${detail}"
    if [[ -w "$LOG_FILE" || ( ! -e "$LOG_FILE" && -w "$(dirname "$LOG_FILE")" ) ]]; then
        printf '%s\n' "$line" >>"$LOG_FILE" 2>/dev/null || true
    fi
}

need_command() { command -v "$1" >/dev/null 2>&1 || die "缺少必需命令：$1"; }

require_base_dependencies() {
    need_command bash
    need_command jq
    need_command python3
}

require_root() {
    if [[ "${EUID}" -ne 0 && "${PORTSENTINEL_ALLOW_NON_ROOT:-0}" != 1 ]]; then
        die "此操作必须使用 root 权限运行。"
    fi
}

acquire_lock() {
    need_command "$FLOCK_CMD"
    mkdir -p "$(dirname "$LOCK_FILE")"
    exec 9>"$LOCK_FILE"
    "$FLOCK_CMD" -n 9 || die "另一个 PortSentinel 操作正在运行，请稍后再试。"
}

default_config() {
    printf '%s\n' '{"version":1,"groups":{},"rules":[]}'
}

ensure_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        require_root
        install -d -m 700 "$CONFIG_DIR" "$BACKUP_DIR"
        default_config >"$CONFIG_FILE"
        chmod 600 "$CONFIG_FILE"
        log_event config-create success
    fi
}

# 记录“配置已写入防火墙”的时间点，用于面板上的待应用提示。
mark_config_applied() {
    : >"$APPLIED_MARKER" 2>/dev/null || return 0
    chmod 600 "$APPLIED_MARKER" 2>/dev/null || true
}

clear_config_applied() {
    rm -f -- "$APPLIED_MARKER" 2>/dev/null || true
}

config_is_pending() {
    [[ -f "$CONFIG_FILE" ]] || return 1
    jq -e '.rules | length > 0' "$CONFIG_FILE" >/dev/null 2>&1 || return 1
    [[ -f "$APPLIED_MARKER" ]] || return 0
    [[ "$CONFIG_FILE" -nt "$APPLIED_MARKER" ]]
}

validate_address() {
    local address="$1" family="${2:-0}"
    python3 - "$address" "$family" <<'PY'
import ipaddress, sys
try:
    value = sys.argv[1]
    expected = int(sys.argv[2])
    obj = ipaddress.ip_network(value, strict=False) if "/" in value else ipaddress.ip_address(value)
    if expected and obj.version != expected:
        raise ValueError("地址族错误")
except ValueError as exc:
    print(exc, file=sys.stderr)
    raise SystemExit(1)
PY
}

validate_port() {
    local spec="$1" first last
    if [[ "$spec" =~ ^([0-9]+)$ ]]; then
        first="${BASH_REMATCH[1]}"; last="$first"
    elif [[ "$spec" =~ ^([0-9]+):([0-9]+)$ ]]; then
        first="${BASH_REMATCH[1]}"; last="${BASH_REMATCH[2]}"
    else
        return 1
    fi
    (( 10#$first >= 1 && 10#$first <= 65535 && 10#$last >= 1 && 10#$last <= 65535 && 10#$first <= 10#$last ))
}

validate_config() {
    local file="${1:-$CONFIG_FILE}"
    [[ -r "$file" ]] || { warn "无法读取配置文件：$file"; return 1; }
    jq -e '
      . as $cfg |
      type == "object" and .version == 1 and
      (.groups | type == "object") and (.rules | type == "array") and
      all(.groups | to_entries[];
        (.key | test("^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$")) and
        (.value | type == "object") and
        (.value.ipv4 | type == "array" and all(.[]; type == "string")) and
        (.value.ipv6 | type == "array" and all(.[]; type == "string"))) and
      all(.rules[];
        (.name | type == "string" and length > 0 and length <= 80) and
        (.protocol == "tcp" or .protocol == "udp" or .protocol == "both") and
        (.port | type == "string") and
        (.groups | type == "array" and all(.[]; type == "string")) and
        (.sources | type == "object") and
        (.sources.ipv4 | type == "array" and all(.[]; type == "string")) and
        (.sources.ipv6 | type == "array" and all(.[]; type == "string")) and
        (.ipv4_default == "drop" or .ipv4_default == "accept") and
        (.ipv6_default == "drop" or .ipv6_default == "accept")) and
      all(.rules[].groups[]; . as $g | $cfg.groups | has($g))
    ' "$file" >/dev/null || { warn "配置文件结构无效。"; return 1; }

    python3 - "$file" <<'PY'
import ipaddress, json, re, sys

with open(sys.argv[1], encoding="utf-8") as fh:
    cfg = json.load(fh)

def address(value, family, where):
    try:
        obj = ipaddress.ip_network(value, strict=False) if "/" in value else ipaddress.ip_address(value)
    except ValueError as exc:
        raise SystemExit(f"{where} 中的地址 {value!r} 无效：{exc}")
    if obj.version != family:
        raise SystemExit(f"{where} 中的地址族错误：{value!r}")

def ports(value):
    match = re.fullmatch(r"([0-9]+)(?::([0-9]+))?", value)
    if not match:
        raise SystemExit(f"端口无效：{value!r}")
    start = int(match.group(1)); end = int(match.group(2) or start)
    if not (1 <= start <= end <= 65535):
        raise SystemExit(f"端口范围无效：{value!r}")
    return start, end

for name, group in cfg["groups"].items():
    for family in (4, 6):
        values = group[f"ipv{family}"]
        if len(values) != len(set(values)):
            raise SystemExit(f"IP Group {name!r} 的 IPv{family} 地址重复")
        for value in values:
            address(value, family, f"IP Group {name!r} IPv{family}")

seen_names = set()
coverage = {"tcp": [], "udp": []}
for rule in cfg["rules"]:
    if rule["name"] in seen_names:
        raise SystemExit(f"规则名称重复：{rule['name']!r}")
    seen_names.add(rule["name"])
    start, end = ports(rule["port"])
    protocols = ("tcp", "udp") if rule["protocol"] == "both" else (rule["protocol"],)
    for proto in protocols:
        for old_start, old_end, old_name in coverage[proto]:
            if max(start, old_start) <= min(end, old_end):
                raise SystemExit(f"{proto.upper()} 端口范围重叠：{rule['name']!r} 与 {old_name!r}")
        coverage[proto].append((start, end, rule["name"]))
    if len(rule["groups"]) != len(set(rule["groups"])):
        raise SystemExit(f"规则 {rule['name']!r} 中存在重复的 IP Group 引用")
    for family in (4, 6):
        values = rule["sources"][f"ipv{family}"]
        if len(values) != len(set(values)):
            raise SystemExit(f"规则 {rule['name']!r} 中的 IPv{family} 来源重复")
        for value in values:
            address(value, family, f"规则 {rule['name']!r} IPv{family}")
PY
}

atomic_replace_config() {
    local candidate="$1"
    validate_config "$candidate" || { rm -f "$candidate"; return 1; }
    python3 - "$candidate" <<'PY'
import os, sys
fd = os.open(sys.argv[1], os.O_RDONLY)
try: os.fsync(fd)
finally: os.close(fd)
PY
    chmod 600 "$candidate"
    mv -f "$candidate" "$CONFIG_FILE"
    python3 - "$CONFIG_DIR" <<'PY'
import os, sys
fd = os.open(sys.argv[1], os.O_RDONLY)
try: os.fsync(fd)
finally: os.close(fd)
PY
}

config_edit() {
    local operation="$1"; shift
    local temp
    temp="$(mktemp "${CONFIG_DIR}/config.json.tmp.XXXXXX")"
    if jq "$@" "$CONFIG_FILE" >"$temp" && atomic_replace_config "$temp"; then
        log_event "$operation" success
    else
        rm -f "$temp"
        log_event "$operation" failure
        return 1
    fi
}

collect_sources() {
    local rule_index="$1" family="$2"
    jq -r --argjson i "$rule_index" --arg fam "ipv${family}" '
      .rules[$i] as $r |
      ([$r.sources[$fam][]] + [$r.groups[] as $g | .groups[$g][$fam][]]) |
      unique[]
    ' "$CONFIG_FILE"
}

generate_rules() {
    RULES_V4=(); RULES_V6=()
    local count index protocol port default4 default6 proto source
    count="$(jq '.rules | length' "$CONFIG_FILE")"
    for ((index=0; index<count; index++)); do
        protocol="$(jq -r --argjson i "$index" '.rules[$i].protocol' "$CONFIG_FILE")"
        port="$(jq -r --argjson i "$index" '.rules[$i].port' "$CONFIG_FILE")"
        default4="$(jq -r --argjson i "$index" '.rules[$i].ipv4_default' "$CONFIG_FILE")"
        default6="$(jq -r --argjson i "$index" '.rules[$i].ipv6_default' "$CONFIG_FILE")"
        local -a protocols=()
        if [[ "$protocol" == both ]]; then protocols=(tcp udp); else protocols=("$protocol"); fi
        for proto in "${protocols[@]}"; do
            local port_begin port_end
            if [[ "$port" == *:* ]]; then port_begin="${port%%:*}"; port_end="${port##*:}"; else port_begin="$port"; port_end="$port"; fi
            if [[ "$proto" == tcp && "$PRESERVE_SSH_FAMILY" == 4 ]] && (( PRESERVE_SSH_PORT >= 10#$port_begin && PRESERVE_SSH_PORT <= 10#$port_end )); then
                RULES_V4+=("-A ${STAGE_CHAIN} -p tcp --dport ${port} -s ${PRESERVE_SSH_SOURCE} -j ACCEPT")
            fi
            while IFS= read -r source; do
                [[ -n "$source" ]] && RULES_V4+=("-A ${STAGE_CHAIN} -p ${proto} --dport ${port} -s ${source} -j ACCEPT")
            done < <(collect_sources "$index" 4)
            if [[ "$default4" == drop ]]; then
                RULES_V4+=("-A ${STAGE_CHAIN} -p ${proto} --dport ${port} -j DROP")
            else
                RULES_V4+=("-A ${STAGE_CHAIN} -p ${proto} --dport ${port} -j RETURN")
            fi

            if [[ "$proto" == tcp && "$PRESERVE_SSH_FAMILY" == 6 ]] && (( PRESERVE_SSH_PORT >= 10#$port_begin && PRESERVE_SSH_PORT <= 10#$port_end )); then
                RULES_V6+=("-A ${STAGE_CHAIN} -p tcp --dport ${port} -s ${PRESERVE_SSH_SOURCE} -j ACCEPT")
            fi
            while IFS= read -r source; do
                [[ -n "$source" ]] && RULES_V6+=("-A ${STAGE_CHAIN} -p ${proto} --dport ${port} -s ${source} -j ACCEPT")
            done < <(collect_sources "$index" 6)
            if [[ "$default6" == drop ]]; then
                RULES_V6+=("-A ${STAGE_CHAIN} -p ${proto} --dport ${port} -j DROP")
            else
                RULES_V6+=("-A ${STAGE_CHAIN} -p ${proto} --dport ${port} -j RETURN")
            fi
        done
    done
    RULES_V4+=("-A ${STAGE_CHAIN} -j RETURN")
    RULES_V6+=("-A ${STAGE_CHAIN} -j RETURN")
}

print_dry_run_family() {
    local family="$1" bin="$2" array_name="$3"
    local -a rules_ref=()
    if [[ "$array_name" == RULES_V4 ]]; then rules_ref=("${RULES_V4[@]}"); else rules_ref=("${RULES_V6[@]}"); fi
    printf '===== IPv%s =====\n' "$family"
    printf '%q -w 5 -N %q\n' "$bin" "$STAGE_CHAIN"
    local rule
    for rule in "${rules_ref[@]}"; do printf '%q -w 5 %s\n' "$bin" "$rule"; done
    printf '# 原子切换：INPUT jump -> %s，删除旧链，将临时链重命名为 %s\n\n' "$STAGE_CHAIN" "$CHAIN"
}

ipv6_state() {
    if [[ -r /proc/sys/net/ipv6/conf/all/disable_ipv6 ]] && [[ "$(< /proc/sys/net/ipv6/conf/all/disable_ipv6)" == 1 ]]; then
        printf 'disabled'; return
    fi
    if command -v "$IP_CMD" >/dev/null 2>&1 && ! "$IP_CMD" -6 addr show >/dev/null 2>&1; then
        printf 'disabled'; return
    fi
    printf 'enabled'
}

family_chain_exists() { "$1" -w 5 -nL "$2" >/dev/null 2>&1; }

cleanup_staging() {
    local bin="$1"
    local temp line
    for temp in "$STAGE_CHAIN" "$OLD_CHAIN"; do
        family_chain_exists "$bin" "$temp" || continue
        if "$bin" -w 5 -C INPUT -j "$temp" >/dev/null 2>&1; then
            if family_chain_exists "$bin" "$CHAIN"; then
                while "$bin" -w 5 -C INPUT -j "$temp" >/dev/null 2>&1; do
                    line="$($bin -w 5 -L INPUT -n --line-numbers 2>/dev/null | awk -v chain="$temp" '$2 == chain { print $1; exit }')"
                    [[ -n "$line" ]] || return 1
                    "$bin" -w 5 -R INPUT "$line" -j "$CHAIN" || return 1
                done
            elif [[ "$temp" == "$STAGE_CHAIN" ]]; then
                "$bin" -w 5 -E "$STAGE_CHAIN" "$CHAIN" || return 1
                continue
            else
                warn "缺少 ${CHAIN}，无法安全恢复仍被引用的 ${OLD_CHAIN} 链。"
                return 1
            fi
        fi
        "$bin" -w 5 -F "$temp" >/dev/null 2>&1 || return 1
        "$bin" -w 5 -X "$temp" >/dev/null 2>&1 || return 1
    done
}

stage_family() {
    local bin="$1" array_name="$2" family="$3"
    local -a rules_ref=()
    if [[ "$array_name" == RULES_V4 ]]; then rules_ref=("${RULES_V4[@]}"); else rules_ref=("${RULES_V6[@]}"); fi
    local rule
    cleanup_staging "$bin" || return 1
    "$bin" -w 5 -N "$STAGE_CHAIN" || return 1
    for rule in "${rules_ref[@]}"; do
        local -a args=()
        read -r -a args <<<"$rule"
        "$bin" -w 5 "${args[@]}" || return 1
    done
    info "IPv${family} 候选规则已验证并写入临时链。"
}

switch_family() {
    local bin="$1" family="$2" first_line
    first_line="$($bin -w 5 -L INPUT -n --line-numbers 2>/dev/null | awk -v chain="$CHAIN" '$2 == chain { print $1; exit }')"
    if [[ -n "$first_line" ]]; then
        "$bin" -w 5 -R INPUT "$first_line" -j "$STAGE_CHAIN" || return 1
        while "$bin" -w 5 -C INPUT -j "$CHAIN" >/dev/null 2>&1; do
            "$bin" -w 5 -D INPUT -j "$CHAIN" || return 1
        done
    else
        "$bin" -w 5 -I INPUT 1 -j "$STAGE_CHAIN" || return 1
    fi

    if family_chain_exists "$bin" "$CHAIN"; then
        "$bin" -w 5 -F "$CHAIN" || return 1
        "$bin" -w 5 -X "$CHAIN" || return 1
    fi
    "$bin" -w 5 -E "$STAGE_CHAIN" "$CHAIN" || return 1
    info "IPv${family} 策略已应用。"
}

rotate_backups() {
    local -a sets=()
    local file stamp
    shopt -s nullglob
    for file in "$BACKUP_DIR"/*.ipv4.rules; do sets+=("$file"); done
    shopt -u nullglob
    if (( ${#sets[@]} <= BACKUP_KEEP )); then return; fi
    mapfile -t sets < <(printf '%s\n' "${sets[@]}" | LC_ALL=C sort)
    local remove_count=$(( ${#sets[@]} - BACKUP_KEEP )) i
    for ((i=0; i<remove_count; i++)); do
        file="${sets[$i]}"; stamp="${file%.ipv4.rules}"
        # 正在进行的事务备份是回滚的唯一依据，任何情况下都不删除。
        if [[ -n "$TRANSACTION_BACKUP" && "$(basename "$stamp")" == "$TRANSACTION_BACKUP" ]]; then
            continue
        fi
        rm -f -- "${stamp}.ipv4.rules" "${stamp}.ipv6.rules"
    done
}

create_backup() {
    local requested="${1:-}" base stamp suffix=0
    base="${requested:-$(date -u '+%Y%m%d-%H%M%S')}"; stamp="$base"
    while [[ -e "${BACKUP_DIR}/${stamp}.ipv4.rules" || -e "${BACKUP_DIR}/${stamp}.ipv6.rules" ]]; do
        suffix=$(( suffix + 1 )); stamp="${base}-${suffix}"
    done
    install -d -m 700 "$BACKUP_DIR"
    local v4="${BACKUP_DIR}/${stamp}.ipv4.rules" v6="${BACKUP_DIR}/${stamp}.ipv6.rules"
    "$IPTABLES_SAVE" >"${v4}.tmp"
    if command -v "$IP6TABLES_SAVE" >/dev/null 2>&1; then
        "$IP6TABLES_SAVE" >"${v6}.tmp"
    else
        printf '# 创建此备份时 IPv6 防火墙不可用\n' >"${v6}.tmp"
    fi
    chmod 600 "${v4}.tmp" "${v6}.tmp"
    mv -f "${v4}.tmp" "$v4"
    mv -f "${v6}.tmp" "$v6"
    TRANSACTION_BACKUP="$stamp"
    rotate_backups
    log_event backup success "set=${stamp}"
    printf '%s\n' "$stamp"
}

restore_backup_set() {
    local stamp="$1"
    local v4="${BACKUP_DIR}/${stamp}.ipv4.rules" v6="${BACKUP_DIR}/${stamp}.ipv6.rules"
    [[ -r "$v4" && -r "$v6" ]] || return 1
    "$IPTABLES_RESTORE" <"$v4" || return 1
    if ! grep -Eq '^# (IPv6 firewall unavailable|创建此备份时 IPv6 防火墙不可用)' "$v6"; then
        command -v "$IP6TABLES_RESTORE" >/dev/null 2>&1 || return 1
        "$IP6TABLES_RESTORE" <"$v6" || return 1
    fi
}

# 回滚成功返回 0，失败返回 1；调用方据此决定如何向用户描述结果。
rollback_transaction() {
    local reason="${1:-failure}"
    [[ "$TRANSACTION_ACTIVE" == 1 && -n "$TRANSACTION_BACKUP" ]] || return 0
    TRANSACTION_ACTIVE=0
    warn "正在把 IPv4 和 IPv6 回滚到备份 ${TRANSACTION_BACKUP}（${reason}）。"
    if restore_backup_set "$TRANSACTION_BACKUP"; then
        log_event rollback success "set=${TRANSACTION_BACKUP} reason=${reason}"
        return 0
    fi
    log_event rollback failure "set=${TRANSACTION_BACKUP} reason=${reason}"
    warn "自动回滚失败，请手动恢复备份 ${TRANSACTION_BACKUP}。"
    return 1
}

apply_failed() {
    local reason="$1" message="$2"
    if rollback_transaction "$reason"; then
        die "${message}IPv4 和 IPv6 已回滚到备份 ${TRANSACTION_BACKUP}。"
    fi
    die "${message}自动回滚失败，请手动恢复备份 ${TRANSACTION_BACKUP}。"
}

on_signal() { rollback_transaction "signal-$1" || true; exit 130; }

# 顶层 trap 不会被 ( ) 子 shell 继承，事务操作必须自己再装一次。
install_transaction_traps() {
    trap 'on_signal INT' INT
    trap 'on_signal TERM' TERM
}
install_transaction_traps

address_contains() {
    local source="$1" candidate="$2"
    python3 - "$source" "$candidate" <<'PY'
import ipaddress, sys
source = ipaddress.ip_address(sys.argv[1])
network = ipaddress.ip_network(sys.argv[2], strict=False)
raise SystemExit(0 if source in network else 1)
PY
}

ssh_source_allowed() {
    local source="$1" server_port="$2" family="$3"
    local count index spec protocol default begin end candidate
    count="$(jq '.rules | length' "$CONFIG_FILE")"
    for ((index=0; index<count; index++)); do
        protocol="$(jq -r --argjson i "$index" '.rules[$i].protocol' "$CONFIG_FILE")"
        [[ "$protocol" == tcp || "$protocol" == both ]] || continue
        spec="$(jq -r --argjson i "$index" '.rules[$i].port' "$CONFIG_FILE")"
        if [[ "$spec" == *:* ]]; then begin="${spec%%:*}"; end="${spec##*:}"; else begin="$spec"; end="$spec"; fi
        (( server_port >= 10#$begin && server_port <= 10#$end )) || continue
        default="$(jq -r --argjson i "$index" --arg fam "ipv${family}_default" '.rules[$i][$fam]' "$CONFIG_FILE")"
        [[ "$default" == accept ]] && return 0
        while IFS= read -r candidate; do
            if address_contains "$source" "$candidate"; then return 0; fi
        done < <(collect_sources "$index" "$family")
        return 1
    done
    return 0
}

ssh_lockout_check() {
    local source server_port extra family
    if [[ -n "${SSH_CONNECTION:-}" ]]; then
        read -r source _ _ server_port extra <<<"$SSH_CONNECTION"
    elif [[ -n "${SSH_CLIENT:-}" ]]; then
        read -r source _ server_port extra <<<"$SSH_CLIENT"
    else
        return 0
    fi
    [[ -z "${extra:-}" && "$server_port" =~ ^[0-9]+$ ]] || { warn "无法解析 SSH 连接信息，已拒绝交互式应用。"; return 1; }
    if validate_address "$source" 4 >/dev/null 2>&1; then family=4
    elif validate_address "$source" 6 >/dev/null 2>&1; then family=6
    else warn "SSH 连接中的来源地址无效：$source"; return 1
    fi
    if command -v "$SS_CMD" >/dev/null 2>&1; then
        if "$SS_CMD" -lntpH 2>/dev/null | awk -v suffix=":${server_port}" '$4 ~ (suffix "$") {found=1} END {exit !found}'; then
            info "已通过 ss -lntp 确认 TCP/${server_port} 上存在 SSH 监听。"
        else
            warn "ss -lntp 未显示 TCP/${server_port}，将使用当前已认证 SSH 会话的信息。"
        fi
    fi
    if ssh_source_allowed "$source" "$server_port" "$family"; then return 0; fi

    printf '\n' >&2
    warn "当前 SSH 会话 ${source} -> TCP/${server_port} 不在新的白名单内。"
    warn "直接应用可能立即中断这条 SSH 连接。"
    if [[ "$PRESERVE_CURRENT_SSH" == 1 ]]; then
        PRESERVE_SSH_SOURCE="$source"; PRESERVE_SSH_FAMILY="$family"; PRESERVE_SSH_PORT="$server_port"
        info "当前 SSH 来源只会临时加入本次候选规则，config.json 不会改变。"
        return 0
    fi
    [[ "$NON_INTERACTIVE" == 0 ]] || return 1
    local answer=""
    prompt_select answer '请选择处理方式：' \
      'preserve:临时放行当前 SSH 来源（推荐，不写入配置文件）' \
      'cancel:取消应用，先把该来源加入白名单' \
      'force:仍然应用（可能立即断开当前 SSH）' || return 1
    case "$answer" in
        preserve)
            PRESERVE_SSH_SOURCE="$source"; PRESERVE_SSH_FAMILY="$family"; PRESERVE_SSH_PORT="$server_port"
            info "当前 SSH 来源只会临时加入本次候选规则，config.json 不会改变。"
            ;;
        force)
            confirm '确认在可能断开当前 SSH 的情况下继续应用？' || return 1
            warn "已按要求强制应用，请准备好带外访问方式。"
            ;;
        *) return 1 ;;
    esac
}

preflight_apply() {
    require_base_dependencies
    validate_config
    if (( DRY_RUN )); then generate_rules; return 0; fi
    require_root
    need_command "$IPTABLES"
    need_command "$IPTABLES_SAVE"
    need_command "$IPTABLES_RESTORE"
    if [[ "$(ipv6_state)" == disabled ]]; then
        SKIP_IPV6=1
        warn "IPv6：已被系统禁用。IPv6 策略仍会保存，但本次不会应用。"
    else
        need_command "$IP6TABLES"
        need_command "$IP6TABLES_SAVE"
        need_command "$IP6TABLES_RESTORE"
    fi
    ssh_lockout_check || die "为保护当前 SSH 会话，已取消应用。"
    generate_rules
}

portsentinel_chain_present() {
    local binary
    for binary in "$IPTABLES" "$IP6TABLES"; do
        command -v "$binary" >/dev/null 2>&1 || continue
        if family_chain_exists "$binary" "$CHAIN"; then return 0; fi
    done
    return 1
}

# 配置里没有受保护端口时，防火墙也不应该留着上一次的规则。
apply_empty_ruleset() {
    if (( DRY_RUN )); then
        printf '# 配置中没有受保护端口：移除 INPUT jump 与 %s 私有链\n' "$CHAIN"
        log_event apply-dry-run success "rules=0"
        return 0
    fi
    require_root
    need_command "$IPTABLES"
    if ! portsentinel_chain_present; then
        mark_config_applied
        info "配置中没有受保护端口，防火墙里也没有 PortSentinel 规则，无需应用。"
        return 0
    fi
    warn "配置中没有受保护端口。应用后会移除全部 PortSentinel 规则，原先受保护的端口将对所有来源开放。"
    if [[ "$NON_INTERACTIVE" == 0 ]]; then
        if ! confirm '确认移除全部 PortSentinel 规则？'; then
            info "已取消应用，防火墙保持不变。"
            return 0
        fi
    fi
    need_command "$IPTABLES_SAVE"
    acquire_lock
    TRANSACTION_BACKUP="$(create_backup)"
    TRANSACTION_ACTIVE=1
    if ! remove_family_rules "$IPTABLES" || ! remove_family_rules "$IP6TABLES"; then
        apply_failed empty-ruleset-failure "移除 PortSentinel 规则失败，"
    fi
    TRANSACTION_ACTIVE=0
    mark_config_applied
    log_event apply success "rules=0 backup=${TRANSACTION_BACKUP}"
    info "已移除全部 PortSentinel 规则。备份编号：${TRANSACTION_BACKUP}"
}

apply_cmd() {
    while (($#)); do
        case "$1" in
            --dry-run) DRY_RUN=1 ;;
            --non-interactive) NON_INTERACTIVE=1 ;;
            --preserve-current-ssh) PRESERVE_CURRENT_SSH=1 ;;
            *) die "未知的 apply 选项：$1" ;;
        esac
        shift
    done
    install_transaction_traps
    [[ -f "$CONFIG_FILE" ]] || { info "配置文件不存在，无需应用。"; return 0; }
    if [[ "$(jq -r '.rules | length' "$CONFIG_FILE" 2>/dev/null || printf invalid)" == 0 ]]; then
        apply_empty_ruleset
        return
    fi
    preflight_apply
    if (( DRY_RUN )); then
        print_dry_run_family 4 "$IPTABLES" RULES_V4
        print_dry_run_family 6 "$IP6TABLES" RULES_V6
        log_event apply-dry-run success
        return 0
    fi
    acquire_lock
    TRANSACTION_BACKUP="$(create_backup)"
    TRANSACTION_ACTIVE=1
    if ! stage_family "$IPTABLES" RULES_V4 4; then
        apply_failed ipv4-stage-failure "IPv4 候选规则失败，"
    fi
    if (( ! SKIP_IPV6 )); then
        if ! stage_family "$IP6TABLES" RULES_V6 6; then
            apply_failed ipv6-stage-failure "IPv6 候选规则失败，"
        fi
    fi
    if ! switch_family "$IPTABLES" 4; then
        apply_failed ipv4-switch-failure "IPv4 规则切换失败，"
    fi
    if (( ! SKIP_IPV6 )); then
        if ! switch_family "$IP6TABLES" 6; then
            apply_failed ipv6-switch-failure "IPv6 规则切换失败，"
        fi
    fi
    TRANSACTION_ACTIVE=0
    mark_config_applied
    log_event apply success "backup=${TRANSACTION_BACKUP} ipv6_skipped=${SKIP_IPV6}"
    info "配置应用成功。备份编号：${TRANSACTION_BACKUP}"
}

backup_cmd() {
    require_root; acquire_lock
    need_command "$IPTABLES_SAVE"
    command -v "$IP6TABLES_SAVE" >/dev/null 2>&1 || warn "找不到 ${IP6TABLES_SAVE}，本次备份只包含 IPv4。"
    local stamp
    stamp="$(create_backup)"
    info "备份已创建：$stamp"
}

list_backups() {
    local file
    shopt -s nullglob
    for file in "$BACKUP_DIR"/*.ipv4.rules; do
        [[ -f "${file%.ipv4.rules}.ipv6.rules" ]] && basename "${file%.ipv4.rules}"
    done | LC_ALL=C sort -r
    shopt -u nullglob
}

restore_cmd() {
    require_root; install_transaction_traps; acquire_lock
    need_command "$IPTABLES_RESTORE"
    command -v "$IP6TABLES_RESTORE" >/dev/null 2>&1 || warn "找不到 ${IP6TABLES_RESTORE}，包含 IPv6 规则的备份将无法恢复。"
    local stamp="${1:-}" selection="" index
    local -a stamps=()
    mapfile -t stamps < <(list_backups)
    (( ${#stamps[@]} > 0 )) || die "没有可用的备份组。"
    if [[ -z "$stamp" ]]; then
        [[ "$NON_INTERACTIVE" == 0 ]] || die "非交互模式必须指定备份时间戳。"
        for index in "${!stamps[@]}"; do
            printf '  %s[%s]%s %s\n' "$(color '1;36')" "$(( index + 1 ))" "$(color 0)" "${stamps[$index]}"
        done
        while true; do
            prompt_input selection '请输入备份序号或完整时间戳：' || return "$PROMPT_CANCEL"
            if [[ "$selection" =~ ^[0-9]+$ ]] && (( selection >= 1 && selection <= ${#stamps[@]} )); then
                stamp="${stamps[$(( selection - 1 ))]}"
                break
            fi
            if [[ -n "$selection" ]] && printf '%s\n' "${stamps[@]}" | grep -Fxq "$selection"; then
                stamp="$selection"
                break
            fi
            warn "备份选择无效，请重新输入。"
        done
    fi
    printf '%s\n' "${stamps[@]}" | grep -Fxq "$stamp" || die "找不到备份组：${stamp}。"
    local safety
    safety="$(create_backup "$(date -u '+%Y%m%d-%H%M%S')-pre-restore")"
    TRANSACTION_BACKUP="$safety"; TRANSACTION_ACTIVE=1
    if restore_backup_set "$stamp"; then
        TRANSACTION_ACTIVE=0
        clear_config_applied
        log_event restore success "set=${stamp} safety=${safety}"
        info "已恢复 IPv4 和 IPv6 备份组：$stamp"
        info "当前防火墙来自备份，与 config.json 可能不一致，请按需重新应用配置。"
    else
        if rollback_transaction restore-failure; then
            die "恢复失败，已重新恢复操作前的防火墙状态。"
        fi
        die "恢复失败，且回滚同样失败，请手动恢复备份 ${safety}。"
    fi
}

remove_family_rules() {
    local bin="$1"
    command -v "$bin" >/dev/null 2>&1 || return 0
    local managed
    for managed in "$CHAIN" "$STAGE_CHAIN" "$OLD_CHAIN"; do
        while "$bin" -w 5 -C INPUT -j "$managed" >/dev/null 2>&1; do "$bin" -w 5 -D INPUT -j "$managed"; done
    done
    cleanup_staging "$bin"
    if family_chain_exists "$bin" "$CHAIN"; then "$bin" -w 5 -F "$CHAIN"; "$bin" -w 5 -X "$CHAIN"; fi
}

reset_cmd() {
    require_root
    if [[ "$NON_INTERACTIVE" == 0 ]]; then
        warn "重置会移除 PortSentinel 的 INPUT 跳转和私有链，受保护端口将立即对所有来源开放。"
        if ! confirm '确认重置 PortSentinel 防火墙规则？'; then
            info "已取消重置。"
            return 0
        fi
    fi
    acquire_lock
    remove_family_rules "$IPTABLES"
    remove_family_rules "$IP6TABLES"
    clear_config_applied
    log_event reset success
    info "已删除 PortSentinel 的 INPUT jump 和私有链，配置文件已保留。"
}

chain_status_label() {
    local binary="$1" family="$2"
    case "$(firewall_family_state "$binary" "$family")" in
        missing) printf '后端不可用' ;;
        disabled) printf '已被系统禁用' ;;
        inactive) printf '规则未生效' ;;
        *) printf '规则已生效' ;;
    esac
}

status_cmd() {
    local v4_backend='未找到' v6_backend='未找到'
    command -v "$IPTABLES" >/dev/null 2>&1 && v4_backend="$($IPTABLES --version 2>/dev/null || true)"
    command -v "$IP6TABLES" >/dev/null 2>&1 && v6_backend="$($IP6TABLES --version 2>/dev/null || true)"

    ui_section "PortSentinel v${VERSION}"
    ui_field 'IPv4 后端' "$v4_backend"
    ui_field 'IPv4 状态' "$(chain_status_label "$IPTABLES" 4)"
    ui_field 'IPv6 后端' "$v6_backend"
    ui_field 'IPv6 状态' "$(chain_status_label "$IP6TABLES" 6)"
    if [[ -f "$CONFIG_FILE" ]] && validate_config >/dev/null 2>&1; then
        ui_field '受保护端口' "$(jq '.rules|length' "$CONFIG_FILE") 条"
        ui_field 'IP Group' "$(jq '.groups|length' "$CONFIG_FILE") 个"
        if config_is_pending; then
            ui_field '配置状态' '有改动尚未应用'
        else
            ui_field '配置状态' '已与防火墙同步'
        fi
    else
        ui_field '配置状态' '不存在或无效'
    fi
    ui_field '配置文件' "$CONFIG_FILE"
    ui_field '备份目录' "$BACKUP_DIR"
}

list_rules() {
    ensure_config
    if ! jq -e '.rules | length > 0' "$CONFIG_FILE" >/dev/null; then
        info "暂无受保护端口规则。"
        return
    fi
    ui_section '受保护端口规则'
    jq -r '
      def protocol_label:
        if . == "both" then "TCP + UDP" else ascii_upcase end;
      def policy_label:
        if . == "drop" then "未匹配时拒绝" else "未匹配时放行" end;
      .rules | to_entries[] |
      .value as $rule |
      ($rule.groups | if length == 0 then "未绑定" else join("、") end) as $groups |
      "  [\(.key + 1)] \($rule.name)\n" +
      "      协议：\($rule.protocol | protocol_label)    端口：\($rule.port)\n" +
      "      IPv4：直接地址 \($rule.sources.ipv4 | length) 个；Group：\($groups)；\($rule.ipv4_default | policy_label)\n" +
      "      IPv6：直接地址 \($rule.sources.ipv6 | length) 个；Group：\($groups)；\($rule.ipv6_default | policy_label)\n"
    ' "$CONFIG_FILE"
}

list_groups() {
    ensure_config
    if ! jq -e '.groups | length > 0' "$CONFIG_FILE" >/dev/null; then
        info "暂无 IP Group。"
        return
    fi
    ui_section 'IP Group 列表'
    jq -r '.groups | to_entries[] |
      "  [\(.key)]\n" +
      "      IPv4（\(.value.ipv4|length)）：\(if (.value.ipv4|length) == 0 then "无" else (.value.ipv4|join("、")) end)\n" +
      "      IPv6（\(.value.ipv6|length)）：\(if (.value.ipv6|length) == 0 then "无" else (.value.ipv6|join("、")) end)\n"' "$CONFIG_FILE"
}

effective_rules_cmd() {
    ensure_config; validate_config || die "配置文件无效。"
    local count index name proto port family default source found
    count="$(jq '.rules|length' "$CONFIG_FILE")"
    if (( count == 0 )); then
        info "暂无受保护端口规则。"
        return 0
    fi
    for ((index=0; index<count; index++)); do
        name="$(jq -r --argjson i "$index" '.rules[$i].name' "$CONFIG_FILE")"
        proto="$(jq -r --argjson i "$index" '.rules[$i].protocol | if . == "both" then "TCP+UDP" else ascii_upcase end' "$CONFIG_FILE")"
        port="$(jq -r --argjson i "$index" '.rules[$i].port' "$CONFIG_FILE")"
        ui_section "[$(( index + 1 ))] ${name}"
        ui_field '协议 / 端口' "${proto}/${port}"
        for family in 4 6; do
            default="$(jq -r --argjson i "$index" --arg key "ipv${family}_default" '.rules[$i][$key]' "$CONFIG_FILE")"
            if [[ "$default" == drop ]]; then default='未匹配时拒绝'; else default='未匹配时放行'; fi
            found=""
            while IFS= read -r source; do
                [[ -n "$source" ]] || continue
                if [[ -z "$found" ]]; then found="$source"; else found+="、${source}"; fi
            done < <(collect_sources "$index" "$family")
            ui_field "IPv${family} 白名单" "${found:-（无）}"
            ui_field "IPv${family} 默认策略" "$default"
        done
    done
    if [[ "${EUID}" -eq 0 ]]; then
        ui_section 'IPv4 计数器'
        "$IPTABLES" -w 5 -L "$CHAIN" -n -v --line-numbers 2>/dev/null || ui_note '规则链尚未启用。'
        ui_section 'IPv6 计数器'
        "$IP6TABLES" -w 5 -L "$CHAIN" -n -v --line-numbers 2>/dev/null || ui_note '规则链尚未启用。'
    fi
}

run_tui_action() {
    local status=0
    ( "$@" ) || status=$?
    case "$status" in
        0) ;;
        "$PROMPT_CANCEL") info "已放弃当前操作，返回菜单。" ;;
        *) warn "操作未完成，已返回当前菜单，请重新选择。" ;;
    esac
}

group_names() { jq -r '.groups | keys | join("、")' "$CONFIG_FILE"; }

show_group_addresses() {
    jq -r --arg name "$1" '
      .groups[$name] |
      "  IPv4：" + (if (.ipv4|length) == 0 then "无" else (.ipv4|join("、")) end),
      "  IPv6：" + (if (.ipv6|length) == 0 then "无" else (.ipv6|join("、")) end)' "$CONFIG_FILE"
}

add_group() {
    local name=""
    ui_hint
    while true; do
        prompt_input name '请输入 IP Group 名称：' || return "$PROMPT_CANCEL"
        if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]]; then
            warn "名称只能使用字母、数字、点、下划线和连字符，请重新输入。"
            continue
        fi
        if ! jq -e --arg name "$name" '.groups | has($name) | not' "$CONFIG_FILE" >/dev/null; then
            warn "IP Group 已存在：${name}，请换一个名称。"
            continue
        fi
        break
    done
    config_edit group-add --arg name "$name" '.groups[$name]={ipv4:[],ipv6:[]}'
    info "已创建 IP Group：${name}。接着可以为它批量添加 IP/CIDR。"
}

prompt_existing_group() {
    local _peg_target="$1" _peg_name=""
    if ! jq -e '.groups | length > 0' "$CONFIG_FILE" >/dev/null; then
        warn "尚未创建 IP Group，请先创建。"
        return 1
    fi
    ui_note "可用 IP Group：$(group_names)"
    while true; do
        prompt_input _peg_name '请输入 IP Group 名称：' || return "$PROMPT_CANCEL"
        if jq -e --arg name "$_peg_name" '.groups | has($name)' "$CONFIG_FILE" >/dev/null; then
            printf -v "$_peg_target" '%s' "$_peg_name"
            return 0
        fi
        warn "找不到 IP Group：${_peg_name}，请重新输入。"
    done
}

add_group_address() {
    local name="" v4_addresses='[]' v6_addresses='[]'
    ui_hint
    prompt_existing_group name || return $?
    prompt_mixed_addresses v4_addresses v6_addresses \
      '请输入要添加的 IP/CIDR（多个用逗号分隔，可混合 IPv4 和 IPv6）：' || return $?
    config_edit group-address-add --arg name "$name" --argjson v4 "$v4_addresses" --argjson v6 "$v6_addresses" \
      '.groups[$name].ipv4 = ((.groups[$name].ipv4 + $v4) | unique) |
       .groups[$name].ipv6 = ((.groups[$name].ipv6 + $v6) | unique)'
    info "已批量更新 IP Group：${name}。请返回主菜单选择 [2] 应用配置。"
}

remove_group_address() {
    local name="" v4_addresses='[]' v6_addresses='[]'
    ui_hint
    prompt_existing_group name || return $?
    if ! jq -e --arg name "$name" '(.groups[$name].ipv4 + .groups[$name].ipv6) | length > 0' "$CONFIG_FILE" >/dev/null; then
        warn "IP Group ${name} 中还没有地址。"
        return 0
    fi
    show_group_addresses "$name"
    prompt_mixed_addresses v4_addresses v6_addresses \
      '请输入要删除的 IP/CIDR（多个用逗号分隔）：' || return $?
    config_edit group-address-remove --arg name "$name" --argjson v4 "$v4_addresses" --argjson v6 "$v6_addresses" \
      '.groups[$name].ipv4 -= $v4 | .groups[$name].ipv6 -= $v6'
    info "已从 IP Group ${name} 中移除所选地址。请返回主菜单选择 [2] 应用配置。"
}

rename_group() {
    local old="" new=""
    ui_hint
    prompt_existing_group old || return $?
    while true; do
        prompt_input new '请输入新的 IP Group 名称：' || return "$PROMPT_CANCEL"
        if [[ ! "$new" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]]; then
            warn "名称只能使用字母、数字、点、下划线和连字符，请重新输入。"
            continue
        fi
        if ! jq -e --arg new "$new" '.groups | has($new) | not' "$CONFIG_FILE" >/dev/null; then
            warn "名称已被占用：${new}，请换一个名称。"
            continue
        fi
        break
    done
    config_edit group-rename --arg old "$old" --arg new "$new" \
      '.groups[$new]=.groups[$old] | del(.groups[$old]) | .rules |= map(.groups |= map(if . == $old then $new else . end))'
    info "已重命名 IP Group：${old} → ${new}。引用该 Group 的规则已同步更新。"
}

delete_group() {
    local name="" references
    ui_hint
    prompt_existing_group name || return $?
    references="$(jq -r --arg name "$name" '[.rules[] | select(.groups | index($name))] | length' "$CONFIG_FILE")"
    if (( references > 0 )); then
        warn "该 IP Group 正被 ${references} 条规则引用，删除后这些规则会失去对应白名单。"
    fi
    if ! confirm "确认删除 IP Group ${name}？"; then
        info "已取消删除。"
        return 0
    fi
    config_edit group-delete --arg name "$name" 'del(.groups[$name]) | .rules |= map(.groups -= [$name])'
    info "已删除 IP Group：${name}。请返回主菜单选择 [2] 应用配置。"
}

groups_menu() {
    local choice
    while true; do
        ui_clear
        ui_header
        ui_section 'IP Group 管理'
        ui_item 1 '查看 Group' '列出每个 Group 的 IPv4/IPv6 地址'
        ui_item 2 '创建 Group' '创建可被多个端口复用的白名单'
        ui_item 3 '添加 IP/CIDR' '逗号分隔批量添加，自动识别地址族'
        ui_item 4 '删除 IP/CIDR' '从指定 Group 中移除一个或多个地址'
        ui_item 5 '重命名 Group' '保留地址并同步更新规则绑定'
        ui_item 6 '删除 Group' '被规则引用时会先给出提示'
        ui_item 0 '返回主菜单'
        ui_prompt
        read -r choice || return 0
        printf '\n'
        case "$choice" in
            1) list_groups ;;
            2) run_tui_action add_group ;;
            3) run_tui_action add_group_address ;;
            4) run_tui_action remove_group_address ;;
            5) run_tui_action rename_group ;;
            6) run_tui_action delete_group ;;
            0) return 0 ;;
            *) warn "无效选项，请重新选择。" ;;
        esac
        ui_pause
    done
}

json_array_from_values() {
    if (( $# == 0 )); then
        printf '[]\n'
    else
        printf '%s\n' "$@" | jq -R . | jq -s 'unique'
    fi
}

prompt_mixed_addresses() {
    local _pma_v4_target="$1" _pma_v6_target="$2"
    local _pma_label="${3:-请输入允许访问的 IP/CIDR（多个用逗号分隔，可混合 IPv4 和 IPv6）：}"
    local _pma_text _pma_raw _pma_item _pma_invalid
    local -a _pma_items=() _pma_v4=() _pma_v6=()
    while true; do
        _pma_text=""
        prompt_input _pma_text "$_pma_label" || return "$PROMPT_CANCEL"
        _pma_items=(); _pma_v4=(); _pma_v6=(); _pma_invalid=""
        if [[ -z "$_pma_text" ]]; then
            warn "IP/CIDR 不能为空，请重新输入。"
            continue
        fi
        IFS=',' read -r -a _pma_items <<<"$_pma_text"
        for _pma_raw in "${_pma_items[@]}"; do
            _pma_item="${_pma_raw#"${_pma_raw%%[![:space:]]*}"}"
            _pma_item="${_pma_item%"${_pma_item##*[![:space:]]}"}"
            if [[ -z "$_pma_item" ]]; then
                _pma_invalid="空值"
            elif validate_address "$_pma_item" 4 >/dev/null 2>&1; then
                _pma_v4+=("$_pma_item")
            elif validate_address "$_pma_item" 6 >/dev/null 2>&1; then
                _pma_v6+=("$_pma_item")
            else
                _pma_invalid="$_pma_item"
            fi
            [[ -z "$_pma_invalid" ]] || break
        done
        if [[ -n "$_pma_invalid" ]]; then
            warn "IP/CIDR 无效：${_pma_invalid}，请重新输入整组地址。"
            continue
        fi
        printf -v "$_pma_v4_target" '%s' "$(json_array_from_values "${_pma_v4[@]}")"
        printf -v "$_pma_v6_target" '%s' "$(json_array_from_values "${_pma_v6[@]}")"
        info "已识别 IPv4 ${#_pma_v4[@]} 个、IPv6 ${#_pma_v6[@]} 个来源。"
        return 0
    done
}

prompt_rule_groups() {
    local _prg_target="$1" _prg_text _prg_candidate _prg_group _prg_missing
    if ! jq -e '.groups | length > 0' "$CONFIG_FILE" >/dev/null; then
        warn "尚未创建 IP Group。请先创建 Group，或改用直接输入 IP/CIDR。"
        return 1
    fi
    ui_note "可用 IP Group：$(group_names)"
    while true; do
        _prg_text=""
        prompt_input _prg_text '请输入 IP Group 名称（多个用逗号分隔）：' || return "$PROMPT_CANCEL"
        _prg_candidate="$(printf '%s' "$_prg_text" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;/^$/d' | jq -R . | jq -s 'unique')"
        if [[ "$(jq 'length' <<<"$_prg_candidate")" -eq 0 ]]; then
            warn "IP Group 名称不能为空，请重新输入。"
            continue
        fi
        _prg_missing=""
        while IFS= read -r _prg_group; do
            if ! jq -e --arg group "$_prg_group" '.groups | has($group)' "$CONFIG_FILE" >/dev/null; then
                _prg_missing="$_prg_group"
                break
            fi
        done < <(jq -r '.[]' <<<"$_prg_candidate")
        if [[ -n "$_prg_missing" ]]; then
            warn "找不到 IP Group：${_prg_missing}，请重新输入。"
            continue
        fi
        printf -v "$_prg_target" '%s' "$_prg_candidate"
        return 0
    done
}

add_rule() {
    local name="" port="" protocol="" source_kind="" status=0
    local group_json='[]' v4_sources='[]' v6_sources='[]'
    ui_hint
    while true; do
        prompt_input name '请输入规则名称（例如 snell）：' || return "$PROMPT_CANCEL"
        [[ -n "$name" ]] && break
        warn "规则名称不能为空，请重新输入。"
    done
    while true; do
        prompt_input port '请输入端口或范围（例如 10773 或 20000:20100）：' || return "$PROMPT_CANCEL"
        validate_port "$port" && break
        warn "端口无效，请重新输入。"
    done
    prompt_select protocol '请选择协议：' 'tcp:TCP' 'udp:UDP' 'both:TCP + UDP' || return "$PROMPT_CANCEL"
    while true; do
        prompt_select source_kind '请选择白名单来源：' \
          'direct:直接输入 IP/CIDR' 'group:绑定已有 IP Group' 'none:暂不添加来源（拒绝所有访问）' || return "$PROMPT_CANCEL"
        status=0
        case "$source_kind" in
            direct) prompt_mixed_addresses v4_sources v6_sources || status=$? ;;
            group) prompt_rule_groups group_json || status=$? ;;
        esac
        if (( status == PROMPT_CANCEL )); then return "$PROMPT_CANCEL"; fi
        if (( status == 0 )); then break; fi
    done

    config_edit rule-add --arg name "$name" --arg protocol "$protocol" --arg port "$port" \
      --argjson groups "$group_json" --argjson v4 "$v4_sources" --argjson v6 "$v6_sources" \
      --arg d4 drop --arg d6 drop \
      '.rules += [{name:$name,protocol:$protocol,port:$port,groups:$groups,sources:{ipv4:$v4,ipv6:$v6},ipv4_default:$d4,ipv6_default:$d6}]'
    info "规则已保存。请返回主菜单选择 [2] 应用配置。"
}

rule_summaries() {
    jq -r '.rules | to_entries[] |
      "  [\(.key + 1)] \(.value.name)  ·  \(.value.protocol | if . == "both" then "TCP+UDP" else ascii_upcase end)/\(.value.port)"' "$CONFIG_FILE"
}

read_rule_index() {
    local _rri_target="$1" _rri_selected _rri_count
    _rri_count="$(jq '.rules | length' "$CONFIG_FILE")"
    if (( _rri_count == 0 )); then
        warn "暂无受保护端口规则，请先添加。"
        return 1
    fi
    rule_summaries
    while true; do
        prompt_input _rri_selected '请输入规则 ID：' || return "$PROMPT_CANCEL"
        if [[ "$_rri_selected" =~ ^[0-9]+$ ]] && (( _rri_selected >= 1 && _rri_selected <= _rri_count )); then
            printf -v "$_rri_target" '%s' "$(( _rri_selected - 1 ))"
            return 0
        fi
        warn "规则 ID 无效，请输入 1-${_rri_count}。"
    done
}

show_rule_sources() {
    jq -r --argjson i "$1" '.rules[$i] |
      "  IPv4：" + (if (.sources.ipv4|length) == 0 then "无" else (.sources.ipv4|join("、")) end),
      "  IPv6：" + (if (.sources.ipv6|length) == 0 then "无" else (.sources.ipv6|join("、")) end)' "$CONFIG_FILE"
}

edit_rule() {
    local index="" field="" value=""
    ui_hint
    read_rule_index index || return $?
    prompt_select field '请选择要修改的内容：' \
      'name:规则名称' 'port:端口或范围' 'protocol:协议' \
      'ipv4_default:IPv4 默认策略' 'ipv6_default:IPv6 默认策略' || return "$PROMPT_CANCEL"
    case "$field" in
        name)
            while true; do
                prompt_input value '请输入新的规则名称：' || return "$PROMPT_CANCEL"
                [[ -n "$value" ]] && break
                warn "规则名称不能为空，请重新输入。"
            done
            config_edit rule-edit --argjson i "$index" --arg value "$value" '.rules[$i].name=$value'
            ;;
        port)
            while true; do
                prompt_input value '请输入新的端口或范围：' || return "$PROMPT_CANCEL"
                validate_port "$value" && break
                warn "端口无效，请重新输入。"
            done
            config_edit rule-edit --argjson i "$index" --arg value "$value" '.rules[$i].port=$value'
            ;;
        protocol)
            prompt_select value '请选择协议：' 'tcp:TCP' 'udp:UDP' 'both:TCP + UDP' || return "$PROMPT_CANCEL"
            config_edit rule-edit --argjson i "$index" --arg value "$value" '.rules[$i].protocol=$value'
            ;;
        *)
            prompt_select value '请选择默认策略：' 'drop:未匹配时拒绝（推荐）' 'accept:未匹配时放行' || return "$PROMPT_CANCEL"
            config_edit rule-edit --argjson i "$index" --arg key "$field" --arg value "$value" '.rules[$i][$key]=$value'
            ;;
    esac
    info "规则已更新。请返回主菜单选择 [2] 应用配置。"
}

add_rule_source() {
    local index="" v4_addresses='[]' v6_addresses='[]'
    ui_hint
    read_rule_index index || return $?
    prompt_mixed_addresses v4_addresses v6_addresses \
      '请输入要加入白名单的 IP/CIDR（多个用逗号分隔，可混合 IPv4 和 IPv6）：' || return $?
    config_edit rule-source-add --argjson i "$index" --argjson v4 "$v4_addresses" --argjson v6 "$v6_addresses" \
      '.rules[$i].sources.ipv4 = ((.rules[$i].sources.ipv4 + $v4) | unique) |
       .rules[$i].sources.ipv6 = ((.rules[$i].sources.ipv6 + $v6) | unique)'
    info "来源已添加。请返回主菜单选择 [2] 应用配置。"
}

remove_rule_source() {
    local index="" v4_addresses='[]' v6_addresses='[]'
    ui_hint
    read_rule_index index || return $?
    if ! jq -e --argjson i "$index" '(.rules[$i].sources.ipv4 + .rules[$i].sources.ipv6) | length > 0' "$CONFIG_FILE" >/dev/null; then
        warn "该规则没有直接来源，绑定的 IP Group 请使用[解绑 IP Group]。"
        return 0
    fi
    show_rule_sources "$index"
    prompt_mixed_addresses v4_addresses v6_addresses \
      '请输入要移除的 IP/CIDR（多个用逗号分隔）：' || return $?
    config_edit rule-source-remove --argjson i "$index" --argjson v4 "$v4_addresses" --argjson v6 "$v6_addresses" \
      '.rules[$i].sources.ipv4 -= $v4 | .rules[$i].sources.ipv6 -= $v6'
    info "已移除所选来源。请返回主菜单选择 [2] 应用配置。"
}

attach_rule_group() {
    local index="" group=""
    ui_hint
    read_rule_index index || return $?
    prompt_existing_group group || return $?
    config_edit rule-group-attach --argjson i "$index" --arg group "$group" \
      '.rules[$i].groups = ((.rules[$i].groups + [$group]) | unique)'
    info "已绑定 IP Group：${group}。请返回主菜单选择 [2] 应用配置。"
}

detach_rule_group() {
    local index="" group=""
    ui_hint
    read_rule_index index || return $?
    if ! jq -e --argjson i "$index" '.rules[$i].groups | length > 0' "$CONFIG_FILE" >/dev/null; then
        warn "该规则没有绑定任何 IP Group。"
        return 0
    fi
    ui_note "当前绑定：$(jq -r --argjson i "$index" '.rules[$i].groups | join("、")' "$CONFIG_FILE")"
    while true; do
        prompt_input group '请输入要解绑的 IP Group 名称：' || return "$PROMPT_CANCEL"
        if jq -e --argjson i "$index" --arg group "$group" '.rules[$i].groups | index($group) != null' "$CONFIG_FILE" >/dev/null; then
            break
        fi
        warn "该规则未绑定：${group}，请重新输入。"
    done
    config_edit rule-group-detach --argjson i "$index" --arg group "$group" '.rules[$i].groups -= [$group]'
    info "已解绑 IP Group：${group}。请返回主菜单选择 [2] 应用配置。"
}

delete_rule() {
    local index="" name=""
    ui_hint
    read_rule_index index || return $?
    name="$(jq -r --argjson i "$index" '.rules[$i].name' "$CONFIG_FILE")"
    if ! confirm "确认删除规则「${name}」？"; then
        info "已取消删除。"
        return 0
    fi
    config_edit rule-delete --argjson i "$index" 'del(.rules[$i])'
    info "已删除规则：${name}。请返回主菜单选择 [2] 应用配置。"
}

protected_ports_menu() {
    local choice
    while true; do
        ui_clear
        ui_header
        ui_section '受保护端口'
        ui_item 1 '查看规则' '协议、端口、来源与默认策略'
        ui_item 2 '添加端口保护' '设置协议与端口，绑定白名单'
        ui_item 3 '编辑规则' '修改名称、端口、协议或默认策略'
        ui_item 4 '删除规则' '移除一条端口保护规则'
        ui_item 5 '添加白名单' '为规则批量添加 IP/CIDR'
        ui_item 6 '删除白名单' '从规则中移除 IP/CIDR'
        ui_item 7 '绑定 IP Group' '复用 Group 中的 IPv4/IPv6 地址'
        ui_item 8 '解绑 IP Group' '停止引用指定 Group'
        ui_item 0 '返回主菜单'
        ui_prompt
        read -r choice || return 0
        printf '\n'
        case "$choice" in
            1) list_rules ;;
            2) run_tui_action add_rule ;;
            3) run_tui_action edit_rule ;;
            4) run_tui_action delete_rule ;;
            5) run_tui_action add_rule_source ;;
            6) run_tui_action remove_rule_source ;;
            7) run_tui_action attach_rule_group ;;
            8) run_tui_action detach_rule_group ;;
            0) return 0 ;;
            *) warn "无效选项，请重新选择。" ;;
        esac
        ui_pause
    done
}

backups_menu() {
    local choice
    while true; do
        ui_clear
        ui_header
        ui_section '备份与恢复'
        ui_item 1 '创建备份' '保存当前 IPv4/IPv6 防火墙快照'
        ui_item 2 '查看备份' '列出全部成对快照'
        ui_item 3 '恢复备份' '恢复前会自动创建安全备份'
        ui_item 0 '返回主菜单'
        ui_prompt
        read -r choice || return 0
        printf '\n'
        case "$choice" in
            1) run_tui_action backup_cmd ;;
            2) show_backups ;;
            3) run_tui_action restore_cmd ;;
            0) return 0 ;;
            *) warn "无效选项，请重新选择。" ;;
        esac
        ui_pause
    done
}

show_backups() {
    local -a stamps=()
    mapfile -t stamps < <(list_backups)
    if (( ${#stamps[@]} == 0 )); then
        info "暂无备份。"
        return 0
    fi
    local stamp
    ui_note "共 ${#stamps[@]} 组备份（最新在前）："
    for stamp in "${stamps[@]}"; do printf '  %s\n' "$stamp"; done
}

update_cmd() {
    require_root
    need_command curl
    local temp
    temp="$(mktemp /tmp/portsentinel-install.XXXXXX)"
    trap 'rm -f -- "$temp"' RETURN
    info "正在从 ${UPDATE_INSTALLER_URL} 下载安装程序"
    curl -fsSL --proto '=https' --tlsv1.2 "$UPDATE_INSTALLER_URL" -o "$temp"
    bash -n "$temp" || die "下载的安装程序未通过 Bash 语法检查。"
    grep -q 'PortSentinel installer' "$temp" || die "下载的文件不是有效的 PortSentinel 安装程序。"
    bash "$temp" --update
    rm -f -- "$temp"
    trap - RETURN
    log_event update success
}

uninstall_cmd() {
    require_root
    local helper=/usr/local/lib/portsentinel/uninstall.sh
    if [[ -x "$helper" ]]; then exec "$helper"; fi
    die "找不到卸载程序。请重新运行 install.sh，然后执行 portsentinel uninstall。"
}

firewall_family_state() {
    local binary="$1" family="$2"
    if ! command -v "$binary" >/dev/null 2>&1; then printf 'missing'; return 0; fi
    if [[ "$family" == 6 && "$(ipv6_state)" == disabled ]]; then printf 'disabled'; return 0; fi
    if family_chain_exists "$binary" "$CHAIN"; then printf 'active'; else printf 'inactive'; fi
}

tui_family_field() {
    local label="$1" binary="$2" family="$3" state value tone
    state="$(firewall_family_state "$binary" "$family")"
    case "$state" in
        missing) value='后端不可用'; tone='1;31' ;;
        disabled) value='已被系统禁用'; tone='1;33' ;;
        inactive) value="$(basename "$binary") · 规则未生效"; tone='1;33' ;;
        *) value="$(basename "$binary") · 规则已生效"; tone='1;32' ;;
    esac
    ui_field "$label" "$value" "$tone"
}

tui_help() {
    ui_section '使用提示'
    ui_note '· 所有修改只会写入 config.json，选择 [2] 应用配置后才会写入防火墙。'
    ui_note '· 任何输入步骤都可以输入 q 放弃当前操作并返回菜单。'
    ui_note '· 通过 SSH 操作时，应用前会检查当前会话是否会被新规则拒绝。'
    ui_note '· 每次应用都会先创建成对的 IPv4/IPv6 备份，失败时自动回滚。'
    ui_section '命令行用法'
    usage
}

tui() {
    ensure_config
    ui_detect_terminal
    local choice rule_count group_count
    while true; do
        ui_clear
        ui_header
        rule_count="$(jq '.rules | length' "$CONFIG_FILE")"
        group_count="$(jq '.groups | length' "$CONFIG_FILE")"

        ui_section '运行状态'
        tui_family_field 'IPv4 防火墙' "$IPTABLES" 4
        tui_family_field 'IPv6 防火墙' "$IP6TABLES" 6
        ui_field '受保护端口' "${rule_count} 条 · IP Group ${group_count} 个"
        if (( rule_count == 0 )); then
            ui_field '配置状态' '尚未配置受保护端口' 2
        elif config_is_pending; then
            ui_field '配置状态' '有改动待应用，请选择 [2]' '1;33'
        else
            ui_field '配置状态' '已与防火墙同步' '1;32'
        fi

        ui_section '常用操作'
        ui_item 1 '添加端口保护' '设置协议与端口，绑定白名单'
        ui_item 2 '应用配置' '校验后写入 IPv4/IPv6 防火墙'
        ui_section '策略管理'
        ui_item 3 '受保护端口' '查看、编辑、删除端口规则'
        ui_item 4 'IP Group' '集中维护可复用的 IP/CIDR'
        ui_item 5 '有效规则' '展开 Group 并查看最终白名单'
        ui_section '系统维护'
        ui_item 6 '备份与恢复' '管理双栈防火墙快照'
        ui_item 7 '防火墙状态' '查看后端、链与配置详情'
        ui_item 8 '重置规则' '仅移除 PortSentinel 私有规则'
        ui_divider
        printf '  %s[u]%s 一键更新   %s[h]%s 帮助   %s[0]%s 退出\n' \
          "$(color '1;36')" "$(color 0)" "$(color '1;36')" "$(color 0)" "$(color '1;36')" "$(color 0)"
        ui_prompt
        read -r choice || return 0
        printf '\n'
        case "$choice" in
            1) run_tui_action add_rule ;;
            2) run_tui_action apply_cmd ;;
            3) protected_ports_menu; continue ;;
            4) groups_menu; continue ;;
            5) run_tui_action effective_rules_cmd ;;
            6) backups_menu; continue ;;
            7) run_tui_action status_cmd ;;
            8) run_tui_action reset_cmd ;;
            u|U) run_tui_action update_cmd ;;
            h|H) tui_help ;;
            0|q|Q) return 0 ;;
            '') continue ;;
            *) warn "无效选项，请重新选择。" ;;
        esac
        ui_pause
    done
}

usage() {
    cat <<'EOF'
用法：portsentinel [命令]

命令：
  status                    查看后端、规则链与配置状态
  list | rule list          列出受保护端口规则
  group list                列出可复用的 IP Group
  effective                 查看展开后的白名单与计数器
  apply [选项]              校验并以事务方式应用 IPv4/IPv6 策略
  backup                    保存成对的 IPv4/IPv6 防火墙备份
  restore [时间戳]          恢复一组成对备份，缺省时可交互选择
  reset [--non-interactive] 仅删除 PortSentinel 防火墙规则
  update                    下载、校验并运行最新安装程序
  uninstall                 安全卸载 PortSentinel
  version                   显示版本
  help                      显示帮助

apply 选项：
  --dry-run                 只打印将要执行的命令，不修改防火墙
  --non-interactive         不询问任何问题，风险操作直接失败
  --preserve-current-ssh    临时放行当前 SSH 来源，不写入配置文件

不带命令运行即可进入交互式管理面板。
EOF
}

main() {
    require_base_dependencies
    ui_detect_terminal
    local command="${1:-}"
    [[ $# -eq 0 ]] || shift
    case "$command" in
        '') tui;;
        status) status_cmd "$@";;
        list) list_rules "$@";;
        rule) [[ "${1:-}" == list ]] || die "用法：portsentinel rule list"; list_rules;;
        group) [[ "${1:-}" == list ]] || die "用法：portsentinel group list"; list_groups;;
        effective) effective_rules_cmd;;
        apply) apply_cmd "$@";;
        backup) backup_cmd "$@";;
        restore) restore_cmd "$@";;
        reset) [[ "${1:-}" == --non-interactive ]] && NON_INTERACTIVE=1; reset_cmd;;
        update) update_cmd;;
        uninstall) uninstall_cmd;;
        version|--version|-V) printf 'PortSentinel %s\n' "$VERSION";;
        help|--help|-h) usage;;
        *) usage >&2; die "未知命令：$command";;
    esac
}

if [[ "${PORTSENTINEL_LIB_ONLY:-0}" != 1 ]]; then main "$@"; fi
